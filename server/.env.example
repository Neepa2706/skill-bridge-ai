# SkillBridge AI Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=skillbridge-super-secret-jwt-key-2026
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 Credentials
# Obtain these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Gemini Generative AI Configuration
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Administrative Account Bootstrapping Secret
# Required for secure POST /api/auth/register/admin provisioning
ADMIN_SETUP_SECRET=skillbridge-admin-key-2026

