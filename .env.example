# ============================================================================
# SkillBridge AI — Environment Configuration Template
# ============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Frontend API Target (Vite Client)
VITE_API_URL=http://localhost:5000

# SQLite Database Location
DB_PATH=skillbridge.db

# Google OAuth 2.0 Credentials (Optional - for Google Sign-In)
# Obtain these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Gemini Generative AI Configuration (Optional - for Live AI Generation)
# If omitted or unconfigured, the application gracefully uses built-in heuristic/deterministic fallbacks
# Obtain your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Administrative Account Bootstrapping Secret
# Required for secure POST /api/auth/register/admin provisioning
ADMIN_SETUP_SECRET=your_admin_setup_secret_here
